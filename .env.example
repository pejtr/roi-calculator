# Server-only configuration. Never prefix these with VITE_ or commit real values.
# Registered LEAD OS project URL and project API key from connected projects.
LEADOS_BASE_URL=https://replace-with-your-leados-host.example
LEADOS_PROJECT_API_KEY=replace-with-project-key
# Exact additional preview origins, comma-separated; primary same-origin works automatically.
ROI_ALLOWED_ORIGINS=
# Set production listener as appropriate; local API defaults to 3001.
PORT=3001
